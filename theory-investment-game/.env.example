# Theory Investment Game - LLM Configuration
# Copy this file to .env and fill in your API keys
# Only one API key is needed - the game will use the first available

# OpenAI API Key (for GPT-4 / GPT-3.5)
OPENAI_API_KEY=

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=

# Google AI API Key (for Gemini)
GOOGLE_API_KEY=
